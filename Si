	private PageLoginPymes pageLogin;
	private PageOrigen pageOrigen;
	private PageConsultasyExtractos pageConsultasyExtractos;
	private PageSaldos pageSaldos;
	private PageCheques pageCheques;
	private PageTxaTravezDelPortal pageTxaTravezDelPortal;
	private ControllerValiPymeMiddle controllerValiPymeMiddle;

	// =====================================================================
	// Configuración y datos de la iteración actual
	// =====================================================================
	private String contratacion;
	private String validarStratus;
	private String navegador;
	private String empresa;
	private String producto;
	private String tiempoConsulta;

	// =====================================================================
	// Configuración inicial (llamado desde initializeControllerAndConfiguration)
	// =====================================================================

	public void doingConfigurations() throws Exception {
		String nombreAmbiente = resolverNombreAmbiente(SettingsRun.getGlobalData("AMBIENTE_PYME"));
		DatosEmpresarial.AMBIENTE_TEST = nombreAmbiente;

		this.contratacion = SettingsRun.getGlobalData("CONTRATACION");
		this.validarStratus = SettingsRun.getGlobalData("VALIDAR.STRATUS");
	}

	private String resolverNombreAmbiente(String ambiente) {
		String nombre;
		switch (ambiente) {
			case "1":
			case "PROYECTOS":
				nombre = "PROYECTOS";
				break;
			case "2":
			case "CONTENCION":
				nombre = "CONTENCION";
				break;
			case "3":
			case "OBSOLESCENCIA":
				nombre = "OBSOLESCENCIA";
				break;
			case "4":
			case "ONPREMISE":
				nombre = "ONPREMISE";
				break;
			case "5":
			case "POST_NUBE":
				nombre = "POST_NUBE";
				break;
			case "6":
			case "CONTENCION_NUBE":
				nombre = "CONTENCION_NUBE";
				break;
			case "7":
			case "PROYECTOS_NUBE":
				nombre = "PROYECTOS_NUBE";
				break;
			case "8":
			case "MEJORAS":
				nombre = "MEJORAS";
				break;
			default:
				Reporter.reportEvent(Reporter.MIC_FAIL, "Opción no válida");
				nombre = ambiente;
		}

		if (nombre == null || nombre.isEmpty()) {
			Reporter.reportEvent(Reporter.MIC_FAIL, "Nombre del ambiente seleccionado: " + nombre);
		} else {
			Reporter.reportEvent(Reporter.MIC_HEADER, "Nombre del ambiente seleccionado: " + nombre);
		}
		return nombre;
	}

	// =====================================================================
	// Orquestación principal del test
	// =====================================================================

	public void doingTest() throws Exception {
		cargarDatosLoginMiddleFijos();
		cargarParametrosDeArchivoDeDatos();

		if (esFlujoConContratacion()) {
			reportarDatosDeContratacion();
		}

		switch (contratacion) {
			case CONTRATACION_SI:
				ejecutarFlujoContratacionCompleta();
				break;
			case CONTRATACION_SOLO:
				ejecutarFlujoSoloMiddle();
				break;
			case CONTRATACION_NO:
				loginStratus();
				front();
				break;
			default:
				Reporter.reportEvent(Reporter.MIC_FAIL, "Opción de contratación no reconocida: " + contratacion);
		}

		Reporter.reportEvent(Reporter.MIC_PASS, "Termina interacion");
		this.pageLogin.terminarIteracion();
	}

	private boolean esFlujoConContratacion() {
		return contratacion.equals(CONTRATACION_SI) || contratacion.equals(CONTRATACION_SOLO);
	}

	private void cargarDatosLoginMiddleFijos() {
		// numCli tipoDoc numDoc clave tipoTok datoTok
		DatosEmpresarial.loadLoginDataFija("0",
				SettingsRun.getGlobalData("MIDDLE.tipoDoc"),
				SettingsRun.getGlobalData("MIDDLE.numeroDeId"),
				SettingsRun.getGlobalData("MIDDLE.clavePersonal"),
				SettingsRun.getGlobalData("MIDDLE.tipoToken"),
				SettingsRun.getGlobalData("MIDDLE.numeroToken"));

		String[] datosLogin = DatosEmpresarial.getLoginData();

		if (esFlujoConContratacion()) {
			Reporter.reportEvent(Reporter.MIC_INFO,
					"*** Datos de Logueo Middle: [" + Util.arrayToString(datosLogin, " - ") + "]");
		}

		String numCliEmp = datosLogin[0];
		String tipoDoc = datosLogin[1];
		String numDoc = datosLogin[2];
		String clave = datosLogin[3];
		String tipoTok = datosLogin[4];
		String datoTok = datosLogin[5];

		PageLoginPymes.datosMidell(numCliEmp, tipoDoc, numDoc, clave, tipoTok, datoTok);
		PageUsuariosEmpresa.datosMidellToke(datoTok);
	}

	private void cargarParametrosDeArchivoDeDatos() {
		this.navegador = SettingsRun.getTestData().getParameter("Navegador").trim();
		this.empresa = SettingsRun.getTestData().getParameter("Nombre Empresa").trim();
		this.producto = SettingsRun.getTestData().getParameter("Producto").trim();
		this.tiempoConsulta = SettingsRun.getTestData().getParameter("Tiempo de Consulta").trim();
	}

	private void reportarDatosDeContratacion() {
		String clienteEmpresarial = SettingsRun.getTestData().getParameter("Cliente Empresarial").trim();
		String idUsuario = SettingsRun.getTestData().getParameter("Id usuario").trim();
		String tipoIdentificacion = SettingsRun.getTestData().getParameter("Tipo Identificación").trim();
		String tipoIdEmpresa = SettingsRun.getTestData().getParameter("Tipo ID Empresa").trim();
		String numeroIdEmpresa = SettingsRun.getTestData().getParameter("Numero ID Empresa").trim();

		Reporter.reportEvent(Reporter.MIC_INFO, "*** Cliente Empresarial: [" + clienteEmpresarial + "]");
		Reporter.reportEvent(Reporter.MIC_INFO,
				"*** Tipo Identificación Usuario: [" + tipoIdentificacion + "] - Id Usuario: [" + idUsuario + "]");
		Reporter.reportEvent(Reporter.MIC_INFO, "*** Tipo Servicio a contratar: [Consultas de Productos]");
		Reporter.reportEvent(Reporter.MIC_INFO, "*** Empresa a contratar: [" + this.empresa + "]");
		Reporter.reportEvent(Reporter.MIC_INFO, "*** Tipo Identificación Empresa: [" + tipoIdEmpresa
