	public String ingresarDestino(String bancoDest, String tipoCta, String ctaDestino, String nombre, String tipoId,
			String numId) throws Exception {

		this.waitPantallaDestino();

		String tipoProdUpper = tipoCta.toUpperCase();
		String tipoProd = resolverTipoCtaIngresarDestino(tipoProdUpper);

		String msgError = esperarYSeleccionar(locBandest, bancoDest.toUpperCase(), false);
		if (msgError.isEmpty()) {
			Evidence.saveFullPage("Error", this);
			return "Error en lista 'Banco Destino' : " + msgError;
		}

		if (tipoProd.equals("CUENTA AHORROS")) {
			tipoProd = "CUENTA DE AHORROS"; // ajuste antes de intentar seleccionar (igual que el original)
		}
		msgError = esperarYSeleccionar(locTipctadest, tipoProdUpper, true);
		if (msgError.isEmpty()) {
			Evidence.saveFullPage("Error", this);
			return "Error en lista 'Tipo Destino' " + tipoProdUpper + " No encontrado: " + msgError;
		}

		Util.wait(2);
		this.write(locNumdest, ctaDestino);
		Util.wait(2);
		this.write(locNumid, numId);
		Util.wait(2);
		this.write(locNomtitu, nombre.toUpperCase());

		msgError = esperarYSeleccionar(locTipid, tipoId.toUpperCase(), true);
		if (msgError.isEmpty()) {
			return "Error en lista 'Tipo de Identificación' : " + msgError;
		}

		Evidence.saveFullPage("ProductoDestino", this);
		Util.wait(1);
		this.click(locButtonSig);

		Util.wait(5);
		return pagePortalPymes.getMsgAlertIfExist("lblMasterAlerta");
	}

	// ***********************************************************************************************************************
	/** Común a los métodos de referencia: espera el botón "Siguiente" y hace clic. */
	private void esperarBotonSiguienteYClic() throws Exception {
		int contador = 0;
		while (this.element(locButtonSig) == null) {
			Util.wait(1);
			contador++;
			if (contador > TIMEOUT_CORTO) {
				Reporter.reportEvent(Reporter.MIC_FAIL, "TimeOut - No se encontró el botón: Siguiente");
				SettingsRun.exitTestIteration();
				break;
			}
		}
		Util.wait(1);
		this.click(locButtonSig);
	}

	/** Común a los métodos de referencia: espera pantalla "Valores" o alerta de error. */
	private String esperarPantallaValoresOAlerta(String msgAcumulado) throws Exception {
		WebElement elementPaso;
		String msgAlerta;
		do {
			elementPaso = this.element(locPasoPageValor);
			msgAlerta = pagePortalPymes.getMsgAlertIfExist("lblMasterAlerta");
		} while (elementPaso == null && msgAlerta == null);

		if (msgAlerta != null) {
			Evidence.saveAllScreens("ErrorReferencia", this);
			return msgAcumulado + msgAlerta;
		}
		return null;
	}

	/**
	 * Ingresa la referencia del pago de una factura.
	 */
	public String ingresarReferencia(String referencia1, String referencia2) throws Exception {
		this.waitPantallaDestino();
		StringBuilder msgError = new StringBuilder();

		WebElement objReferencia = this.element(locReferencia1);
		if (objReferencia != null) {
			Util.wait(2);
			this.write(objReferencia, referencia1);
			msgError.append("[REF1:").append(referencia1).append("] - ");
		}

		objReferencia = this.element(locReferencia2);
		if (objReferencia != null) {
			Util.wait(2);
			this.write(objReferencia, referencia2);
			msgError.append("[REF2:").append(referencia2).append("] - ");
		}

		Evidence.saveAllScreens("RefServicio", this);
		esperarBotonSiguienteYClic();

		return esperarPantallaValoresOAlerta(msgError.toString());
	}

