	}

	// =====================================================================
	// Flujos de contratación (Middle)
	// =====================================================================

	private void ejecutarFlujoContratacionCompleta() throws Exception {
		if (loginMiddle() != null) {
			return;
		}
		validarFirmasMiddle();
		this.pageLogin.CerrarSesionMiddle();
		front();
	}

	private void ejecutarFlujoSoloMiddle() throws Exception {
		if (loginMiddle() != null) {
			return;
		}
		validarFirmasMiddle();
		this.pageLogin.CerrarSesionMiddle();
	}

	private String loginMiddle() throws Exception {
		this.pageLogin = new PageLoginPymes(this.navegador);
		String msgError = this.pageLogin.loginMiddle();
		this.pageLogin.selecionambienteClose("SI");
		return msgError;
	}

	private void validarFirmasMiddle() throws Exception {
		this.controllerValiPymeMiddle = new ControllerValiPymeMiddle(this.pageLogin);
		int numeroDeFirmas = 1;
		this.controllerValiPymeMiddle.ValidacionMiddlefirmas(numeroDeFirmas);
	}

	// =====================================================================
	// Flujo Front
	// =====================================================================

	/**
	 * Realiza el logueo en el portal Front Pyme y despacha la consulta
	 * seleccionada en el archivo de datos.
	 */
	private void front() throws Exception {
		DatosEmpresarial.loadLoginData("Cliente Empresarial", "Tipo Identificación", "Id usuario",
				"Clave personal o CVE", "Tipo Token", "Semilla / Valor Estático / Celular");
		String[] datosLogin = DatosEmpresarial.getLoginData();
		Reporter.reportEvent(Reporter.MIC_INFO,
				"*** Datos de Logueo Front: [" + Util.arrayToString(datosLogin, " - ") + "]");

		if (intentarLoginFront() != null) {
			return;
		}

		if (!abrirVentanaEmergentePortal()) {
			this.pageLogin.terminarIteracion();
			return;
		}

		this.pageOrigen = new PageOrigen(this.pageLogin);
		String msgError = this.pageOrigen.seleccionarEmpresa(this.empresa);

		if (msgError != null) {
			Reporter.reportEvent(Reporter.MIC_FAIL, msgError);
			this.pageLogin.terminarIteracion();
			return;
		}

		procesarTipoDeConsulta();
	}

	private String intentarLoginFront() throws Exception {
		String msgError;
		int intento = 0;
		do {
			this.pageLogin = new PageLoginPymes(this.navegador);
			msgError = this.pageLogin.loginFront();
			this.pageLogin.selecionambienteClose("NO");

			if (this.pageLogin.element(LOCATOR_MENSAJE_LOG30) != null) {
				this.pageLogin.NavegadorFront(this.pageLogin.URL_FRONT);
				intento++;
			}
		} while (this.pageLogin.element(LOCATOR_MENSAJE_LOG30) != null && intento < MAX_INTENTOS_LOGIN_FRONT);
		return msgError;
	}

	private boolean abrirVentanaEmergentePortal() throws Exception {
		boolean isWindowOpened = this.pageLogin.WaitForNumberOfWindos();
		if (!isWindowOpened) {
			Reporter.reportEvent(Reporter.MIC_FAIL, "No se abrió La ventana emergente");
			return false;
		}
		Reporter.reportEvent(Reporter.MIC_PASS, "La ventana emergente se abrió correctamente");

		this.pageLogin.closeCurrentBrowser();
		this.pageLogin.changeWindow(this.pageLogin.accedioAlPortal());
		return true;
	}

	private void procesarTipoDeConsulta() throws Exception {
		String tipoConsulta = SettingsRun.getTestData().getParameter("Tipo de Consulta").trim();
		String formatoDescarga = SettingsRun.getTestData().getParameter("Formato de Descarga").trim();
		String tipoProducto = SettingsRun.getTestData().getParameter("Tipo producto a Consultar").trim();

		this.pageConsultasyExtractos = new PageConsultasyExtractos(this.pageLogin);

		if (tipoConsulta.equals(TIPO_RESUMEN_PRODUCTOS)) {
			this.pageConsultasyExtractos.ResumenDeprodutos();
			return;
		}

		String consultaDesdeLista = SettingsRun.getTestData().getParameter("Hacer consulta desde Lista").trim();
		String numeroProducto = SettingsRun.getTestData()
				.getParameter("Número producto a Consultar / numProducto-titular (filtro)").trim();
		boolean listaConsulta = consultaDesdeLista.equals(HA_CONS_DESDE_LISTA);

		String msg = this.pageConsultasyExtractos.SaldosConsolidado(navegador, producto, tipoConsulta,
				listaConsulta, tipoProducto, numeroProducto);
		if (msg != null) {
			Reporter.reportEvent(Reporter.MIC_FAIL, msg);
			this.pageLogin.terminarIteracion();
			return;
		}

		Util.startWinAppDriver();

		switch (tipoConsulta) {
			case TIPO_SALDOS:
				procesarSaldos(tipoProducto, numeroProducto);
				break;
			case TIPO_MOVIMIENTOS:
				procesarMovimientos(tipoConsulta, tipoProducto, numeroProducto, formatoDescarga);
				break;
			case TIPO_DESCARGA_MOVIMIENTOS:
				// No lleva Stratus
				this.pageConsultasyExtractos.MovimientosPorProducto(tipoConsulta, tipoProducto, tiempoConsulta,
						tipoProducto, numeroProducto, true, formatoDescarga);
				break;
			case TIPO_CHEQUERAS:
				// No lleva Stratus
				procesarCheques(tipoProducto, numeroProducto);
				break;
			case TIPO_CHEQUES_DEVUELTOS:
				// No lleva Stratus
				this.pageCheques = new PageCheques(this.pageLogin);
				this.pageCheques.Chequesdevuel(tipoProducto, numeroProducto);
				break;
			case TIPO_TX_A_TRAVES_PORTAL:
				procesarTxATravesDelPortal(tipoProducto, numeroProducto, false);
				break;
			case TIPO_DESCARGA_TX_A_TRAVES:
				// No lleva Stratus
				procesarTxATravesDelPortal(tipoProducto, numeroProducto, true);
				break;
			default:
				Reporter.reportEvent(Reporter.MIC_FAIL, "Tipo de consulta no soportado: " + tipoConsulta);
		}
	}

	// =====================================================================
	// SALDOS
	// =====================================================================

	private void procesarSaldos(String tipoProducto, String numeroProducto) throws Exception {
		this.pageSaldos = new PageSaldos(this.pageLogin);

		String[] saldoPortal = this.pageSaldos.ConsultaSaldo(tipoProducto, numeroProducto);
		if (saldoPortal == null || saldoPortal.equals(" ")) {
			Reporter.reportEvent(Reporter.MIC_FAIL, "No se encontro información");
			this.pageLogin.terminarIteracion();
			return;
		}

		if (DatosDavivienda.STRATUS == null
				|| tipoProducto.equalsIgnoreCase("Leasing")) {
			return;
		}

		String tipoEmpresa = SettingsRun.getTestData().getParameter("Tipo ID Empresa");
		String numeroEmpresa = SettingsRun.getTestData().getParameter("Numero ID Empresa").trim();
		String tipoProductoStratus = normalizarTipoProductoParaStratus(tipoProducto);

		String[] datosStratus = DatosDavivienda.STRATUS.consultarDatosPantallaSaldos(
				tipoEmpresa, numeroEmpresa, tipoProductoStratus, numeroProducto);

		compararSaldoPortalConStratus(saldoPortal, datosStratus, tipoProductoStratus);
	}

	private String normalizarTipoProductoParaStratus(String tipoProducto) {
		if (tipoProducto.contains("Rentalíquida") || tipoProducto.contains("Dafuturo")
				|| tipoProducto.contains("Daviplus") || tipoProducto.contains("Seguridad Bolivar")
				|| tipoProducto.contains("Superior") || this.producto.contains("FAMILIA FONDOS")) {
			return "FONDO";
		}
		return tipoProducto;
	}

	private void compararSaldoPortalConStratus(String[] saldoPortal, String[] datosStratus,
			String tipoProductoStratus) {

		boolean esFondo = this.producto.contains("FAMILIA FONDOS") || tipoProductoStratus.equals("FONDO");

		if (esFondo) {
			Reporter.reportEvent(Reporter.MIC_INFO,
					"Dato consultado Portal Pyme[" + saldoPortal[0].replace("$ ", "").trim() + "]");
			Reporter.reportEvent(Reporter.MIC_INFO, "Dato consultado Stratus[" + datosStratus[1] + "]");
			return;
		}

		if (tipoProductoStratus.equals("Crediexpress")) {
			Reporter.reportEvent(Reporter.MIC_INFO,
					"Dato consultado Portal Pyme[" + saldoPortal[0].replace("$ ", "").trim() + "]");
			Reporter.reportEvent(Reporter.MIC_INFO, "Dato consultado Stratus[" + datosStratus[1] + "]");
			return;
		}

		boolean sonIguales = true;
		for (int i = 0; i < datosStratus.length; i++) {
			String datoStratusLimpio = datosStratus[i].replace("$ ", "").trim();
			String datoStratusFormateado = this.pageSaldos.formatearNumero(datoStratusLimpio);

			if (i >= saldoPortal.length || saldoPortal[i] == null) {
				continue;
			}
			String datoPortalLimpio = saldoPortal[i].replace("$ ", "").trim()
					.replace(".", "").trim().replace(",", ".").trim();
			String datoPortalFormateado = this.pageSaldos.formatearNumero(datoPortalLimpio);

			Reporter.reportEvent(Reporter.MIC_INFO, "Dato consultado Portal Pyme[" + i + "]: " + datoPortalFormateado);
			Reporter.reportEvent(Reporter.MIC_INFO, "Dato consultado Stratus[" + i + "]: " + datoStratusFormateado);

			if (!datoStratusFormateado.equals(datoPortalFormateado)) {
				Reporter.reportEvent(Reporter.MIC_INFO, "Diferencia en el campo " + (i + 1) + ":");
				sonIguales = false;
				break;
			}
		}

		if (sonIguales) {
			Reporter.reportEvent(Reporter.MIC_PASS, "Los datos son iguales.");
		} else {
			Reporter.reportEvent(Reporter.MIC_FAIL, "Los datos son diferentes.");
		}
	}

	// =====================================================================
	// MOVIMIENTOS
	// =====================================================================

	private void procesarMovimientos(String tipoConsulta, String tipoProducto, String numeroProducto,
			String formatoDescarga) throws Exception {

		String[] movimientosCrudos = this.pageConsultasyExtractos.MovimientosPorProducto(
				tipoConsulta, tipoProducto, tiempoConsulta, tipoProducto, numeroProducto, false, formatoDescarga);

		Reporter.write("===============Datos portal Pyme===============");
		for (String info : movimientosCrudos) {
			Reporter.write("Movimiento portal: " + info);
			Reporter.write("---------------------------");
		}
		Reporter.write(" ");

		List<String[]> movimientosPortal = convertirMovimientosPortal(movimientosCrudos, tipoProducto);

		if (DatosDavivienda.STRATUS == null) {
			return;
		}

		String tipoDocumento = SettingsRun.getTestData().getParameter("Tipo Identificación");
		String numeroDoc = SettingsRun.getTestData().getParameter("Id usuario").trim();
		List<String[]> movimientosStratus = obtenerMovimientosStratus(tipoProducto, numeroProducto,
				tipoDocumento, numeroDoc);

		compararMovimientosPortalConStratus(movimientosPortal, movimientosStratus);
	}

	private List<String[]> convertirMovimientosPortal(String[] movimientosCrudos, String tipoProducto) {
		List<String[]> movimientosPortal = new ArrayList<>();
		Reporter.write("===============Conversion Arreglo del portal===============");

		if (tipoProducto.contains("Daviplus")) {
			for (String data : movimientosCrudos) {
				String[] campos = data.split(", ");

				Date fecha = Util.stringToDate(campos[0].trim(), "YYYY-DD-MM");
				String fechaFormateada = new SimpleDateFormat("MMdd").format(fecha);
				String movimiento = campos[1].trim();
				double valorTx = Double.parseDouble(campos[2].trim());

				Reporter.write("Movimiento: " + fechaFormateada + " " + movimiento + "   "
						+ BigDecimal.valueOf(valorTx));

				String linea = fechaFormateada + " " + movimiento + "   " + BigDecimal.valueOf(valorTx);
				movimientosPortal.add(linea.split(","));
			}
			return movimientosPortal;
		}

		for (String data : movimientosCrudos) {
			String[] campos = data.split(", ");

			Date fecha = Util.stringToDate(campos[0].trim(), "dd/MM/yyyy");
			String fechaFormateada = new SimpleDateFormat("MMdd").format(fecha);
			String documento = Util.leftComplete(campos[1].trim(), 8, '0');
			String descripcion = campos[2].trim();
			String transaccion = campos[3].trim();
			String oficina = campos[4].trim();
			double valorCheque = Double.parseDouble(campos[6].trim());
			double valorTotal = Double.parseDouble(campos[7].trim());

			String[] datosConsulta = this.pageConsultasyExtractos.Consulta(descripcion, transaccion, oficina);

			Reporter.write("Movimiento: " + fechaFormateada + " " + documento + "  " + datosConsulta[0] + "   "
					+ datosConsulta[1] + "   " + datosConsulta[2] + "   " + BigDecimal.valueOf(valorCheque)
					+ "   " + BigDecimal.valueOf(valorTotal));

			String linea = fechaFormateada + " " + documento + " " + datosConsulta[0] + " " + datosConsulta[1]
					+ " " + datosConsulta[2] + " " + BigDecimal.valueOf(valorCheque) + " "
					+ BigDecimal.valueOf(valorTotal);

			movimientosPortal.add(linea.split(","));
		}
		return movimientosPortal;
	}

	private List<String[]> obtenerMovimientosStratus(String tipoProducto, String numeroProducto,
			String tipoDocumento, String numeroDoc) throws Exception {

		String[] fechasConsulta = this.pageConsultasyExtractos.today();
		Date fechaInicial = Util.stringToDate(fechasConsulta[0], "dd/MM/yyyy");
		Date fechaFinal = Util.stringToDate(fechasConsulta[1], "dd/MM/yyyy");

		String tipoProductoStratus = Stratus.getTipoCuenta(tipoProducto);
		String[] datosTitular = { tipoDocumento, numeroDoc };
		String[] arrayVentanillas = { MovimientoStratus.VENT_UNID };

		List<MovimientoStratus> movimientos = DatosDavivienda.STRATUS.getMovimientosEnRango(
				tipoProductoStratus, numeroProducto, arrayVentanillas, fechaInicial, fechaFinal, datosTitular);
		Collections.reverse(movimientos);

		Reporter.write("===============Datos Stratus===============");

		List<String[]> movimientosStratus = new ArrayList<>();
		for (MovimientoStratus movimiento : movimientos) {
			String movToString = movimiento.toString()
					.replaceAll("\\[INDIC: |UNID :|\\[|\\]", "")
					.replaceAll(" \\| ", ",");

			String[] datos = movToString.split(",");
			String fecha = datos[0];
			String talon = datos[3];
			String tipoStratus = datos[4];
			String oficinaStratus = datos[5];
			double valorTotal = Double.parseDouble(datos[6]);
			String motivoStratus = datos[7];
			double valorCheque = Double.parseDouble(datos[9]);

			Reporter.write("Movimiento: " + fecha + " " + talon + " " + motivoStratus + "   " + tipoStratus
					+ "   " + oficinaStratus + "   " + BigDecimal.valueOf(valorCheque) + "   "
					+ BigDecimal.valueOf(valorTotal));

			String linea = fecha + " " + talon + " " + motivoStratus + " " + tipoStratus + " " + oficinaStratus
					+ " " + BigDecimal.valueOf(valorCheque) + " " + BigDecimal.valueOf(valorTotal);

			if (linea.contains("0034") || linea.contains("0055")) {
				movimientosStratus.add(linea.split(","));
			}
		}
		return movimientosStratus;
	}

	private void compararMovimientosPortalConStratus(List<String[]> movimientosPortal,
			List<String[]> movimientosStratus) {

		Reporter.write(" ");
		Reporter.write("===============Comparación Datos===============");

		int total = Math.min(movimientosPortal.size(), movimientosStratus.size());
		for (int i = 0; i < total; i++) {
			String[] movimientoPortal = movimientosPortal.get(i);
			String[] movimientoStratus = movimientosStratus.get(i);

			if (Arrays.equals(movimientoPortal, movimientoStratus)) {
				Reporter.write("*** PASSED Movimiento igual: " + Arrays.toString(movimientoPortal) + " = "
						+ Arrays.toString(movimientoStratus));
				Reporter.write("------------------------------------");
				continue;
			}

			if (movimientoPortal.length == movimientoStratus.length) {
				reportarDiferenciasMovimiento(movimientoPortal, movimientoStratus);
			}
		}
	}

	/**
	 * Compara campo a campo (fecha, documento, descripción, tipo movimiento,
	 * oficina, valor cheque, valor total) y reporta la primera diferencia
	 * encontrada.
	 *
	 * <p>Nota: en la versión original la comparación del campo "Tipo Movimiento"
	 * usaba {@code movimientoPortal.equals(movimientoStratus)} (comparando los
	 * arreglos completos por referencia), lo que nunca detectaba diferencias en
	 * ese campo. Aquí se corrige comparando el campo correspondiente
	 * (índice 3) entre ambos lados.</p>
	 */
	private void reportarDiferenciasMovimiento(String[] movimientoPortal, String[] movimientoStratus) {
		for (int j = 0; j < movimientoPortal.length; j++) {
			String[] campoPortal = movimientoPortal[j].split(" ");
			String[] campoStratus = movimientoStratus[j].split(" ");

			String msgCampoDiferente = null;
			if (!campoPortal[0].trim().equals(campoStratus[0].trim())) {
				msgCampoDiferente = "Fecha: ";
			}
			if (!campoPortal[1].trim().equals(campoStratus[1].trim())) {
				msgCampoDiferente = "Documento: ";
			}
			if (!campoPortal[2].trim().equals(campoStratus[2].trim())) {
				msgCampoDiferente = "Descripción: ";
			}
			if (!campoPortal[3].trim().equals(campoStratus[3].trim())) {
				msgCampoDiferente = "Tipo Movimiento: ";
			}
			if (!campoPortal[4].trim().equals(campoStratus[4].trim())) {
				msgCampoDiferente = "Oficina: ";
			}
			if (Double.parseDouble(campoPortal[5].trim()) != Double.parseDouble(campoStratus[5].trim())) {
				msgCampoDiferente = "Valor Cheque: ";
			}
			if (Double.parseDouble(campoPortal[6].trim()) != Double.parseDouble(campoStratus[6].trim())) {
				msgCampoDiferente = "Valor Total: ";
			}

			Reporter.reportEvent(Reporter.MIC_FAIL, "");
			Reporter.write("*** FAILED Movimiento diferente en el campo " + msgCampoDiferente
					+ Arrays.toString(movimientoPortal) + " = " + Arrays.toString(movimientoStratus));
		}
	}

