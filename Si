	// Punto de entrada: despacha según el "Tipo prueba"
	public void Inscripcion(BasePageWeb pageLogin) throws Exception {

		basepageWeb = pageLogin;

		String typeTest = SettingsRun.getTestData().getParameter("Tipo prueba");
		switch (typeTest) {

		case TX_INSCRIBIR_CUENTA:
			this.InscribirCuenta();
			break;

		case TX_INSCRIPCION_ARCHIVO:
			this.InscripcionPorArchivo();
			break;

		case TX_MODIFICAR_CUENTA:
			this.ModificarCuenta();
			break;

		case TX_ELIMINAR_CUENTA:
			this.EliminarCuenta();
			break;

		case TX_CONSULTAR_INSCRIPCION:
			this.AccesoRuta();
			this.ConsultarCuenta();
			break;

		default:
			Reporter.reportEvent(Reporter.MIC_WARNING, "Tipo de prueba no reconocido: " + typeTest);
			break;
		}
	}

