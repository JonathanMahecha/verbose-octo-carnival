	// Constantes de negocio
	// =====================================================================
	private static final String CONTRATACION_SI = "SI";
	private static final String CONTRATACION_SOLO = "SOLO";
	private static final String CONTRATACION_NO = "NO";
	private static final String HA_CONS_DESDE_LISTA = "SI";

	private static final String TIPO_RESUMEN_PRODUCTOS = "RESUMEN PRODUCTOS";
	private static final String TIPO_SALDOS = "SALDOS";
	private static final String TIPO_MOVIMIENTOS = "MOVIMIENTOS";
	private static final String TIPO_DESCARGA_MOVIMIENTOS = "DESCARGA MOVIMIENTOS";
	private static final String TIPO_CHEQUERAS = "CHEQUERAS";
	private static final String TIPO_CHEQUES_DEVUELTOS = "CHEQUES DEVUELTOS";
	private static final String TIPO_TX_A_TRAVES_PORTAL = "TX A TRAVÉS PORTAL";
	private static final String TIPO_DESCARGA_TX_A_TRAVES = "DESCARGA TX A TRAVÉS";

	private static final By LOCATOR_MENSAJE_LOG30 = By.xpath("/html/body/h2[1]/p");
	private static final int MAX_INTENTOS_LOGIN_FRONT = 3;

	// =====================================================================
	// Page objects / colaboradores (se crean bajo demanda durante el flujo)
