	/**
	 * Este método se usa para seleccionar una cuenta destino, que primero permite
	 * realizar un filtro de búsqueda.<br>
	 * El filtro se hace por el banco y por el número de la cuenta.<br>
	 * Se sugiere usar para destinos Cuenta Inscrita.<br>
	 */
	public String seleccionarDestino(String bancDest, String tipoCuenta, String ctaDestin) throws Exception {
		String msgAlerta = pagePortalPymes.getMsgAlertIfExist("lblMasterAlerta");
		if (msgAlerta != null) {
			Evidence.saveFullPage("SinCtasInscritas", this);
			return msgAlerta;
		}

		this.waitPantallaDestino();
		this.write(locNumdesctains, ctaDestin);

		String msgError = pagePortalPymes.selectOption(locbandesctains, bancDest, false);
		if (msgError.isEmpty()) {
			return "Error en lista 'Banco Destino' : " + msgError;
		}

		this.click(locBtnbuscar);
		Util.wait(2);
		// TERMINAR SELECCION DE CUENTA DESTINO PARA PAGOS CUENTA INSCRITA
		return this.seleccionarDestino(tipoCuenta, ctaDestin);
	}

	// ***********************************************************************************************************************
	/**
	 * Reemplaza los ciclos "do { ... } while (!isDisplayed(loc))" originales, que
	 * podían quedar en bucle infinito si el combo nunca llegaba a mostrarse.
	 * Reintenta selectOption con tope de intentos.
	 */
	private String esperarYSeleccionar(By locator, String valor, boolean porTexto) throws Exception {
		String msgError = "";
		int intentos = 0;
		while (!this.isDisplayed(locator) && intentos < TIMEOUT_CORTO) {
			Util.wait(1);
			msgError = pagePortalPymes.selectOption(locator, valor, porTexto);
			intentos++;
		}
		return msgError;
	}

	private String resolverTipoCtaIngresarDestino(String tipoProdUpper) {
		if (tipoProdUpper.contains("AHORRO OTROS BANCOS"))
			return "CUENTAS AHORRO OTROS BANCOS";
		if (tipoProdUpper.contains("CORRIENTES OTROS BANCOS"))
			return "CUENTAS CORRIENTES OTROS BANCOS";
		if (tipoProdUpper.contains("CORRIENTE"))
			return "CUENTA CORRIENTE";
		if (tipoProdUpper.contains("AHORROS"))
			return "CUENTA AHORROS";
		if (tipoProdUpper.contains("DEPÓSITOS ELECTR") || tipoProdUpper.contains("DEPOSITOS ELECTR"))
			return "DEPÓSITOS ELECTRONICOS";
		return "";
	}

