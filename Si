	// =====================================================================
	// Configuración inicial (llamado desde initializeControllerAndConfiguration)
	// =====================================================================

	public void doingConfigurations() throws Exception {
		String nombreAmbiente = mapearAmbiente(globalData("AMBIENTE_PYME"));
		if (isEmpty(nombreAmbiente)) {
			fail("Nombre del ambiente seleccionado: " + nombreAmbiente);
		} else {
			Reporter.reportEvent(Reporter.MIC_HEADER, "Nombre del ambiente seleccionado: " + nombreAmbiente);
		}
		DatosEmpresarial.AMBIENTE_TEST = nombreAmbiente;

		this.contratacion = globalData("CONTRATACION");
		this.validarStratus = globalData("VALIDAR.STRATUS");
	}

	/** Mismo mapeo de ambiente usado en ControllerTestPyme - mantiene consistencia entre controllers. */
	private String mapearAmbiente(String codigo) {
		if (codigo == null)
			return "";
		switch (codigo) {
			case "1":
			case "POST_NUBE":
				return "POST_NUBE";
			case "2":
			case "CONTENCION_NUBE":
				return "CONTENCION_NUBE";
			case "3":
			case "PROYECTOS_NUBE":
				return "PROYECTOS_NUBE";
			case "4":
			case "PROYECTOS_SO":
				return "PROYECTOS_SO";
			case "5":
			case "POST_SO":
				return "POST_SO";
			case "6":
			case "CONT_SO":
				return "CONT_SO";
			default:
				return "";
		}
	}

	// =====================================================================
	// Orquestación principal del test
	// =====================================================================

	public void doingTest() throws Exception {
		cargarDatosLoginMiddleFijos();
		cargarParametrosDeArchivoDeDatos();

		if (esFlujoConContratacion()) {
			reportarDatosDeContratacion();
		}

		switch (contratacion) {
			case SI:
				ejecutarFlujoContratacionCompleta();
				break;
			case SOLO:
				ejecutarFlujoSoloMiddle();
				break;
			case NO:
				if (SI.equals(validarStratus)) {
					loginStratus();
				}
				front();
				break;
			default:
				fail("Opción de contratación no reconocida: " + contratacion);
		}

		pass("Termina interacion");
		this.pageLogin.terminarIteracion();
	}

	private boolean esFlujoConContratacion() {
		return contratacion.equals(SI) || contratacion.equals(SOLO);
	}

