	/**
	 * Inicializa la conexión a Stratus una única vez, si el flag
	 * {@code VALIDAR.STRATUS} está activo.
	 */
	private void loginStratus() {
		if (!"SI".equals(validarStratus) || DatosDavivienda.STRATUS != null) {
			return;
		}
		String usuario = SettingsRun.getGlobalData("STRATUS.usuario");
		String password = SettingsRun.getGlobalData("STRATUS.password");
		DatosDavivienda.STRATUS = new Stratus(usuario, password, "EMPRESAS");
		Reporter.reportEvent(Reporter.MIC_INFO, "Se cargan datos para logueo de Stratus");
	}

