	// Orquestación principal del test
	// =====================================================================

	public void doingTest() throws Exception {
		cargarDatosLoginMiddleFijos();
		cargarParametrosDeArchivoDeDatos();

		if (esFlujoConContratacion()) {
			reportarDatosDeContratacion();
		}

		switch (contratacion) {
			case CONTRATACION_SI:
				ejecutarFlujoContratacionCompleta();
				break;
			case CONTRATACION_SOLO:
				ejecutarFlujoSoloMiddle();
				break;
			case CONTRATACION_NO:
				loginStratus();
				front();
				break;
			default:
				Reporter.reportEvent(Reporter.MIC_FAIL, "Opción de contratación no reconocida: " + contratacion);
		}

		Reporter.reportEvent(Reporter.MIC_PASS, "Termina interacion");
		this.pageLogin.terminarIteracion();
	}

	private boolean esFlujoConContratacion() {
		return contratacion.equals(CONTRATACION_SI) || contratacion.equals(CONTRATACION_SOLO);
	}

