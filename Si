	/**
	 * Recorre las reglas keyword -> valor UI y devuelve el primer match. Reemplaza
	 * las cadenas if/else duplicadas que existían en los distintos métodos
	 * "seleccionar...".
	 */
	private String resolverTipoProd(String tipoProducto, String[][] reglas, String valorPorDefecto) {
		String tipoProdUpper = tipoProducto == null ? "" : tipoProducto.trim().toUpperCase();
		for (String[] regla : reglas) {
			if (tipoProdUpper.contains(regla[0])) {
				return regla[1];
			}
		}
		return valorPorDefecto;
	}

	/**
	 * Busca el radio button del producto destino, manejando el caso FIC (antes
	 * era código idéntico copiado en 3 métodos distintos).
	 *
	 * BUG CORREGIDO: la condición original
	 *   if (!tipoProdUpper.contains("FIC") || tipoProdUpper.contains("FIC"))
	 * es una tautología (A || !A = siempre true), por lo que la rama "ES FIC"
	 * nunca se ejecutaba en 2 de los 3 métodos originales. Aquí queda corregida
	 * a simplemente "!tipoProdUpper.contains("FIC")".
	 */
	private WebElement buscarRadioButtonDestino(String tipoProdUpper, String tipoProd, String numeroProducto)
			throws Exception {
		String ultimo4 = Util.right(numeroProducto, 4);

		if (!tipoProdUpper.contains("FIC")) {
			String xPathRB = xPathRBDestino.replace("NUM_PROD", ultimo4).replace("TIPO_PROD", tipoProd);
			return this.element(xPathRB);
		}

		String xPathRB = xPathRBDestinoFic.replace("NUM_PROD", ultimo4);
		List<WebElement> listaObjs = this.findElements(By.xpath(xPathRB));
		for (WebElement element : listaObjs) {
			String tipoProdTab = this.getText(this.element(element, locTipoPruebaFic));
			if (tipoProdTab != null && !Util.itemContainsAnyArrayItem(tipoProdTab.toUpperCase(), arrTipoProdNoFic)) {
				return element;
			}
		}
		return null;
	}

