public String getCodigoXNombreContained(String nombre) {
    try {
        String nombreBuscar = Util.removeAccents(nombre.trim().toUpperCase());

        // Coincidencia exacta por nombre
        if (catalogoXNombre.containsKey(nombreBuscar)) {
            return catalogoXNombre.get(nombreBuscar);
        }

        // Buscar por nombre o por código
        for (Map.Entry<String, String> entry : catalogoXNombre.entrySet()) {
            String keyNombre = entry.getKey();
            String codigo = entry.getValue();

            if ((keyNombre != null &&
                    (keyNombre.contains(nombreBuscar) || nombreBuscar.contains(keyNombre)))
                ||
                (codigo != null &&
                    (codigo.contains(nombreBuscar) || nombreBuscar.contains(codigo)))) {

                return codigo;
            }
        }

    } catch (Exception e) {
        Util.wait(1);
    }

    return nombre;
}
