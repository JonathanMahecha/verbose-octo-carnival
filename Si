boolean seEncontro = false;

while (!seEncontro) {

    waitElements(10, By.xpath("//table[@class='TablaGrilla']"));

    List<WebElement> elementosTabla = findElements(
            By.xpath("//table[@class='TablaGrilla']//*[contains(@id,'NumerodeCuenta')]"));

    for (WebElement numeroProd : elementosTabla) {

        if (getText(numeroProd).contains(productNumber)) {

            WebElement checkbox = numeroProd.findElement(
                    By.xpath("./ancestor::tr[contains(@class,'CeldaGrilla')]//input[@type='checkbox']"));

            click(checkbox);
            seEncontro = true;
            break;
        }
    }

    if (seEncontro) {
        break;
    }

    List<WebElement> btnSiguiente = findElements(
            By.xpath("//a[contains(text(),'Siguiente') and @href]"));

    if (btnSiguiente.isEmpty()) {
        throw new NoSuchElementException(
                "No se encontró el producto '" + productNumber + "' en ninguna página.");
    }

    click(btnSiguiente.get(0));

    waitLoadPage();
}
