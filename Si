	/** Navega hasta el menú de Inscripciones, validando el navegador configurado. */
	public void AccesoRuta() throws Exception {
		this.pageOrigen = new PageOrigen(basepageWeb);
		this.pagePortalPymes = new PagePortalPymes(pageOrigen);

		if (waitElements(TIMEOUT_ELEMENTO_SEGUNDOS, tablaInicio) != null) {
			this.failAndTerminate("TimeOut Busqueda empresa");
		}

		String pagoyTx = this.pagePortalPymes.getTextMid();
		String navegador = SettingsRun.getTestData().getParameter("Navegador").trim();
		String msgError;

		if (navegador.contains(NAVEGADOR_CHROME)) {
			if (pagoyTx.contains(OPCION_PAGOS_MINUSCULA)) {
				Util.wait(1);
				msgError = pagePortalPymes.irAOpcion("", OPCION_PAGOS_MINUSCULA, SUBMENU_INSCRIPCIONES);
			} else if (pagoyTx.contains(OPCION_PAGOS_MAYUSCULA)) {
				Util.wait(1);
				msgError = pagePortalPymes.irAOpcion("", OPCION_PAGOS_MAYUSCULA, SUBMENU_INSCRIPCIONES);
			} else {
				msgError = pagePortalPymes.irAOpcion("", OPCION_PAGOS_INSCRIPCIONES, SUBMENU_INSCRIPCIONES);
			}
		} else {
			msgError = pagePortalPymes.irAOpcionMoZilla("", OPCION_PAGOS_MAYUSCULA, null, null, null);

			if (pagoyTx.contains(OPCION_PAGOS_MINUSCULA)) {
				Util.wait(1);
				msgError = pagePortalPymes.irAOpcionMoZilla("", OPCION_PAGOS_MINUSCULA, SUBMENU_INSCRIPCIONES, null,
						null);
			} else if (pagoyTx.contains(OPCION_PAGOS_MAYUSCULA)) {
				Util.wait(1);
				msgError = pagePortalPymes.irAOpcionMoZilla("", OPCION_PAGOS_MAYUSCULA, SUBMENU_INSCRIPCIONES, null,
						null);
			} else if (pagoyTx.contains(OPCION_PAGOS_Y_TRANSFERENCIAS)) {
				Util.wait(1);
				msgError = pagePortalPymes.irAOpcionMoZilla("", OPCION_PAGOS_Y_TRANSFERENCIAS, SUBMENU_INSCRIPCIONES,
						null, null);
			}
		}

		if (msgError != null) {
			Reporter.reportEvent(Reporter.MIC_WARNING, msgError);
			this.pageOrigen.terminarIteracion();
			return;
		}

		Evidence.save("Inscripciones", this);
	}

	/**
	 * Consulta una cuenta inscrita para poder realizarle una acción posterior
	 * (edición o eliminación). Recorre la tabla paginada de inscripciones hasta
	 * encontrar el producto buscado o agotar el límite de páginas.
	 */
	public void ConsultarCuenta() throws Exception {
		String destinationType = SettingsRun.getTestData().getParameter("Tipo de destino").trim();
		String productNumber = SettingsRun.getTestData().getParameter("Número de producto destino").trim();
		productNumber = Util.right(productNumber, 4);

		By selectProductDest = By.xpath(
				trInscripciones2.replace("[VARIANTE1]", destinationType).replace("[VARIANTE2]", productNumber));

		boolean seEncontro = false;
		for (int pagina = 0; pagina < MAX_PAGINAS_BUSQUEDA && !seEncontro; pagina++) {
			if (isDisplayed(selectProductDest)) {
				Evidence.save("Producto encontrado", this, element(selectProductDest));
				click(selectProductDest);
				seEncontro = true;
			} else {
				Evidence.saveFullPage("Se cambia de pantalla ya que no se encuentra", this);
				Reporter.write("No se encuentra producto, se procede a pasar a la siguiente pagina");

				if (!isDisplayed(btnSiguientePagina)) {
					break;
				}
				click(btnSiguientePagina);
			}
		}

		if (!seEncontro) {
			throw new NoSuchElementException(
					"No se encontró el producto '" + productNumber + "' en ninguna página al consultar la cuenta.");
		}
	}

	/** Aprueba la transacción actual (OTP) y valida el mensaje resultante. */
	public void AprobarTx() throws Exception {
		this.pageConfirmacion = new PageConfirmacion(this);
		this.pageConfirmacion.aprobarTx();

		this.pagePortalPymes = new PagePortalPymes(this);
		String mensaje = this.pagePortalPymes.getMsgAlertIfExist("lblMasterAlerta");

		if (mensaje == null) {
			Reporter.reportEvent(Reporter.MIC_PASS, "La transacción se aprobó sin mensajes de alerta.");
		} else {
			Reporter.reportEvent(Reporter.MIC_FAIL, "Se visualizó el siguiente mensaje al aprobar: " + mensaje);
			this.pageOrigen.terminarIteracion();
		}
	}

	/**
	 * Espera hasta TIMEOUT_ELEMENTO_SEGUNDOS a que el locator esté presente,
	 * usando WebDriverWait en vez de un polling manual con Util.wait(1).
	 *
	 * @return null si el elemento apareció a tiempo, o un mensaje de error si
	 *         hizo timeout.
	 */
	public String espera(By locator) {
		try {
			new WebDriverWait(getDriver(), Duration.ofSeconds(TIMEOUT_ELEMENTO_SEGUNDOS))
					.until(ExpectedConditions.presenceOfElementLocated(locator));
			return null;
		} catch (org.openqa.selenium.TimeoutException e) {
			return "No se encontro el elemento";
		}
	}

	/**
	 * Reporta un fallo y termina la iteración actual de la prueba. Centraliza el
	 * patrón "reportEvent(MIC_FAIL) + terminarIteracion()" repetido en toda la
	 * clase.
	 */
	private void failAndTerminate(String msg) throws Exception {
		Reporter.reportEvent(Reporter.MIC_FAIL, msg);
		this.pageOrigen.terminarIteracion();
	}

	/**
	 * Devuelve el nombre del primer campo vacío encontrado, o null si todos
	 * tienen información. Antes se reportaban todos los valores juntos, lo que
	 * dificultaba identificar cuál campo faltaba realmente.
	 */
	private String primerCampoVacio(String[] nombres, String[] valores) {
		for (int i = 0; i < nombres.length; i++) {
			if (valores[i] == null || valores[i].isEmpty()) {
				return nombres[i];
			}
		}
		return null;
	}

	/**
	 * Construye el arreglo de locators a diligenciar según el tipo de destino,
	 * evitando duplicar el if/else de InscribirCuenta y ConsultarCuenta.
	 */
	private By[] construirCamposInscripcion(String destinationType) {
		if (destinationType.equals(TIPO_DESTINO_SEG_SOCIAL)) {
			return new By[] { nombreTitular, numeroIdentificacion, correo };
		}
		return new By[] { numeroDestino, nombreTitular, numeroIdentificacion, correo };
	}

	/** Diligencia una lista de campos del formulario con los datos indicados. */
	private static void ingresarDatos(WebDriver driver, By[] fields, String[] data) throws Exception {
		if (fields.length != data.length) {
			Reporter.reportEvent(Reporter.MIC_WARNING, "La cantidad de campos y datos no coinciden");
			return;
		}

		for (int i = 0; i < fields.length; i++) {
			WebElement field = driver.findElement(fields[i]);
			if (!field.isDisplayed()) {
				Reporter.reportEvent(Reporter.MIC_FAIL,
						"No se encontró el campo " + fields[i] + ", por favor verifique la información.");
				SettingsRun.exitTestIteration();
				continue;
			}
			field.clear();
			Util.wait(2);
			field.sendKeys(data[i]);
		}
	}

	/**
	 * Carga un archivo en el diálogo nativo del sistema operativo mediante
	 * portapapeles + teclas simuladas (Robot). Se mantiene esta estrategia por
	 * ser la usada por el framework para interactuar con el diálogo nativo del
	 * SO, que Selenium no puede controlar directamente.
	 */
	public void uploadFile(String fileLocation) {
		StringSelection stringSelection = new StringSelection(fileLocation);
		Toolkit.getDefaultToolkit().getSystemClipboard().setContents(stringSelection, null);

		Robot robot;
		try {
			robot = new Robot();
		} catch (AWTException e) {
			Reporter.reportEvent(Reporter.MIC_FAIL,
					"No se pudo inicializar java.awt.Robot para cargar el archivo: " + e.getMessage());
			return;
		}

		Util.wait(1);
		robot.keyPress(KeyEvent.VK_CONTROL);
		robot.keyPress(KeyEvent.VK_V);
		robot.keyRelease(KeyEvent.VK_V);
		robot.keyRelease(KeyEvent.VK_CONTROL);
		Evidence.save("Inscripcion por archivo", this);
		Util.wait(1);
		robot.keyPress(KeyEvent.VK_ENTER);
		robot.keyRelease(KeyEvent.VK_ENTER);
	}

