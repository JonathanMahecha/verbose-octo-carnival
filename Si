	private String resolverNombreAmbiente(String ambiente) {
		String nombre;
		switch (ambiente) {
			case "1":
			case "PROYECTOS":
				nombre = "PROYECTOS";
				break;
			case "2":
			case "CONTENCION":
				nombre = "CONTENCION";
				break;
			case "3":
			case "OBSOLESCENCIA":
				nombre = "OBSOLESCENCIA";
				break;
			case "4":
			case "ONPREMISE":
				nombre = "ONPREMISE";
				break;
			case "5":
			case "POST_NUBE":
				nombre = "POST_NUBE";
				break;
			case "6":
			case "CONTENCION_NUBE":
				nombre = "CONTENCION_NUBE";
				break;
			case "7":
			case "PROYECTOS_NUBE":
				nombre = "PROYECTOS_NUBE";
				break;
			case "8":
			case "MEJORAS":
				nombre = "MEJORAS";
				break;
			default:
				Reporter.reportEvent(Reporter.MIC_FAIL, "Opción no válida");
				nombre = ambiente;
		}

		if (nombre == null || nombre.isEmpty()) {
			Reporter.reportEvent(Reporter.MIC_FAIL, "Nombre del ambiente seleccionado: " + nombre);
		} else {
			Reporter.reportEvent(Reporter.MIC_HEADER, "Nombre del ambiente seleccionado: " + nombre);
		}
		return nombre;
	}

