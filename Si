	/** Realiza una inscripción de cuenta desde el formulario manual. */
	public void InscribirCuenta() throws Exception {
		String destinationType = SettingsRun.getTestData().getParameter("Tipo de destino").trim();
		String bankDestination = SettingsRun.getTestData().getParameter("Banco de destino").trim();
		String numProduct = SettingsRun.getTestData().getParameter("Número de producto destino").trim();
		String ownersName = SettingsRun.getTestData().getParameter("Nombre del titular").trim();
		String identifyType = SettingsRun.getTestData().getParameter("Tipo de identificación").trim();
		String numIdentificacion = SettingsRun.getTestData().getParameter("Número de identificación").trim();
		String email = SettingsRun.getTestData().getParameter("Correo (opc)").trim();

		Reporter.reportEvent(Reporter.MIC_INFO,
				"Información para Inscripción: [ " + destinationType + " - " + bankDestination + " - " + numProduct
						+ " - " + ownersName + " - " + identifyType + " - " + numIdentificacion + " - " + email + " ]");

		// AccesoRuta() ya inicializa pageOrigen y pagePortalPymes; no se deben
		// recrear aquí con un "padre" distinto (bug detectado en la versión
		// original, donde se sobrescribía pageOrigen con new PageOrigen(pagePortalPymes)).
		this.AccesoRuta();

		if (this.espera(btnNuevaInscripcion) != null) {
			this.failAndTerminate("No se encuentra boton Nueva Inscripción");
		}
		this.click(btnNuevaInscripcion);

		String campoFaltante = primerCampoVacio(
				new String[] { "Tipo de destino", "Banco de destino", "Número de producto destino",
						"Nombre del titular", "Tipo de identificación", "Número de identificación" },
				new String[] { destinationType, bankDestination, numProduct, ownersName, identifyType,
						numIdentificacion });

		if (campoFaltante != null) {
			Reporter.reportEvent(Reporter.MIC_WARNING, "No se encuentra la información del campo '" + campoFaltante
					+ "', por favor verifique la información para realizar la inscripción.");
			this.pageOrigen.terminarIteracion();
			return;
		}

		String msg;

		if (this.espera(tipoDestino) != null) {
			this.failAndTerminate("No se encuentra boton Inscripción");
		}
		this.selectListItem(tipoDestino, destinationType);

		if (this.espera(bancoDestino) != null) {
			this.failAndTerminate("No se encuentra boton Inscripción");
		}
		msg = this.selectListItem(bancoDestino, bankDestination);
		if (msg != null && msg.equals(" ")) {
			this.failAndTerminate(msg);
		}

		if (this.espera(tipoIdentificacion) != null) {
			this.failAndTerminate("No se encuentra boton Inscripción");
		}
		msg = this.selectListItem(tipoIdentificacion, identifyType);
		if (msg != null && msg.equals(" ")) {
			this.failAndTerminate(msg);
		}

		By[] fields = construirCamposInscripcion(destinationType);
		String[] data = destinationType.equals(TIPO_DESTINO_SEG_SOCIAL)
				? new String[] { ownersName, numIdentificacion, email }
				: new String[] { numProduct, ownersName, numIdentificacion, email };

		Util.wait(1);
		this.ingresarDatos(getDriver(), fields, data);

		Reporter.reportEvent(Reporter.MIC_INFO, "Se ingresó correctamente la información en el formulario.");
		Evidence.saveAllScreens("Inscripción cuenta", this);

		if (this.espera(btnAdicionarInscripcion) != null) {
			this.failAndTerminate("No se encuentra boton Inscripción.");
		}

		this.click(btnAdicionarInscripcion);
		Evidence.saveAllScreens("Inscripciones evidencia", this);
		Util.wait(2);

		this.pagePortalPymes = new PagePortalPymes(basepageWeb);
		String alerta = this.pagePortalPymes.getMsgAlertIfExist("lblMasterAlerta");
		if (alerta != null) {
			Evidence.save("Inscripciones evidencia", this);
			this.failAndTerminate("Se visualizo el siguiente mensaje: " + alerta);
			return;
		}

		Evidence.save("Inscripción cuenta", this);
		this.AprobarTx();
		Reporter.reportEvent(Reporter.MIC_PASS, "Se realizó la inscripción correctamente.");
		this.pageOrigen.terminarIteracion();
	}

	/** Realiza inscripciones masivas cargando un archivo Excel. */
	public void InscripcionPorArchivo() throws Exception {
		String formatoArchivo = SettingsRun.getTestData().getParameter("Formato Archivo").trim();
		String rutaArchivo = SettingsRun.getTestData().getParameter("Ruta Archivo").trim();
		String tipoPrueba = SettingsRun.getTestData().getParameter("Tipo prueba").trim();

		this.AccesoRuta();
		Util.wait(2);

		if (!tipoPrueba.equals(TX_INSCRIPCION_ARCHIVO) || rutaArchivo.isEmpty()) {
			Reporter.reportEvent(Reporter.MIC_WARNING,
					"No se ha encontrado una ruta específica para realizar el cargue, por favor verifique el documento.");
			return;
		}

		if (this.espera(btnNuevaInscripcion) != null) {
			this.failAndTerminate("No se encuentra boton Inscripción");
		}
		this.click(btnNuevaInscripcion);

		if (this.espera(formatoExcel) != null) {
			this.failAndTerminate("No se encuentra el selector de formato de archivo");
		}

		String msg = pagePortalPymes.seleOptionIgual(formatoExcel, formatoArchivo);
		if (msg != null && msg.equals(" ")) {
			this.failAndTerminate(msg);
		}

		Evidence.save("Inscripcion por archivo", this);
		this.click(btnBuscarArchivo);

		this.uploadFile(rutaArchivo);
		Util.wait(2);
		this.click(btnCargarArchivo);
		Util.wait(30);
		Evidence.save("Inscripcion por archivo", this);
		this.click(btnAprobarInscripcion);
		Util.wait(1);
		this.AprobarTx();
		Evidence.save("Inscripcion por archivo", this);
		Reporter.reportEvent(Reporter.MIC_PASS, "Se realizaron las inscripciones correctamente.");
		this.pageOrigen.terminarIteracion();
	}

	/** Modifica el correo de una cuenta inscrita previamente. */
	public void ModificarCuenta() throws Exception {
		String numProduct = SettingsRun.getTestData().getParameter("Número de producto destino").trim();
		String ownersName = SettingsRun.getTestData().getParameter("Nombre del titular").trim();
		String identificationNumber = SettingsRun.getTestData().getParameter("Número de identificación").trim();
		String email = SettingsRun.getTestData().getParameter("Correo (opc)").trim();

		this.AccesoRuta();
		this.ConsultarCuenta();
		Util.wait(1);
		Evidence.save("Evidencia modificar cuenta", this);

		String numeroProd = Util.right(numProduct, 4);
		String txtNumProduct = Util.right(this.getText(btnModificar), 4);

		String btnModify = modificar.replace("NUMERO_PRODUCTO", numeroProd)
				.replace("NUMERO_IDENTIFICACION", identificationNumber).replace("TITULAR", ownersName);
		Reporter.reportEvent(Reporter.MIC_INFO, "Se valida la siguiente información: Texto encontrado en Pyme: "
				+ txtNumProduct + ", Texto ingresado en el Excel: " + numeroProd);

		boolean datosCompletosYCoinciden = !ownersName.isEmpty() && !identificationNumber.isEmpty()
				&& !numProduct.isEmpty() && numeroProd.equals(txtNumProduct);

		if (datosCompletosYCoinciden) {
			this.findElements(By.xpath(btnModify));
		} else {
			this.click(btnModificar);
		}
		Evidence.save("Evidencia modificar cuenta", this);

		WebElement editEmail = this.element(modificarCorreo);
		this.clearInputbox(editEmail);
		editEmail.sendKeys(email);
		Evidence.save("Evidencia modificar cuenta", this);
		Util.wait(1);
		this.AprobarTx();
		Evidence.save("Evidencia modificar cuenta", this);
		Reporter.reportEvent(Reporter.MIC_PASS, "Se realizó la Modificación correctamente.");
		this.pageOrigen.terminarIteracion();
	}

	/** Elimina una cuenta previamente inscrita, buscándola a través de la tabla paginada. */
	public void EliminarCuenta() throws Exception {
		this.AccesoRuta();

		String productNumber = SettingsRun.getTestData().getParameter("Número de producto destino").trim();
		productNumber = Util.right(productNumber, 4);

		boolean seEncontro = buscarYSeleccionarProductoEnTablaPaginada(productNumber);

		if (!seEncontro) {
			throw new NoSuchElementException(
					"No se encontró el producto '" + productNumber + "' en ninguna página.");
		}

		Evidence.save("Evidencias eliminar cuenta", this);

		if (this.element(btnEliminar) == null) {
			Reporter.reportEvent(Reporter.MIC_PASS, "No se realizó la eliminación de la cuenta inscrita");
			this.pageOrigen.terminarIteracion();
			return;
		}

		this.click(btnEliminar);
		Util.wait(2);
		Evidence.save("Evidencias eliminar cuenta", this);

		if (this.element(btnAprobarEliminacion) != null) {
			this.element(btnAprobarEliminacion).click();
		}

		this.existDialog();
		Evidence.save("Evidencias eliminar cuenta", this);
		this.AprobarTx();
		Evidence.save("Evidencias eliminar cuenta", this);
		Reporter.reportEvent(Reporter.MIC_PASS, "Se realizó la eliminación de la cuenta inscrita correctamente.");
		this.pageOrigen.terminarIteracion();
	}

	/**
	 * Recorre la tabla de cuentas inscritas (paginada) buscando el producto
	 * indicado y, si lo encuentra, marca su checkbox. Limitado a
	 * MAX_PAGINAS_BUSQUEDA para evitar loops infinitos si el producto no existe
	 * y la paginación no tiene fin (p. ej. un botón "Siguiente" que no avanza).
	 */
	private boolean buscarYSeleccionarProductoEnTablaPaginada(String productNumber) throws Exception {
		for (int pagina = 0; pagina < MAX_PAGINAS_BUSQUEDA; pagina++) {
			waitElements(10, By.xpath("//table[@class='TablaGrilla']"));

			List<WebElement> elementosTabla = findElements(
					By.xpath("//table[@class='TablaGrilla']//*[contains(@id,'NumerodeCuenta')]"));

			for (WebElement numeroProd : elementosTabla) {
				if (getText(numeroProd).contains(productNumber)) {
					WebElement checkbox = numeroProd.findElement(
							By.xpath("./ancestor::tr[contains(@class,'CeldaGrilla')]//input[@type='checkbox']"));
					click(checkbox);
					return true;
				}
			}

			List<WebElement> btnSiguiente = findElements(By.xpath("//a[contains(text(),'Siguiente') and @href]"));
			if (btnSiguiente.isEmpty()) {
				return false;
			}
			click(btnSiguiente.get(0));
			Util.wait(2);
		}
		return false;
	}

